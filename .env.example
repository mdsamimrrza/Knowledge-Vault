# ─────────────────────────────────────────────────────────────
# Knowledge-Vault — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────

# Required — MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/knowledge-vault

# Required — Session encryption secret
# Must be at least 32 characters. Use a random generator.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-minimum-32-characters-long

# Required — Master key for Super Admin operations
# Must be at least 16 characters.
ADMIN_SECRET_KEY=replace-with-your-master-key-minimum-16-chars

# Required — Email address of the designated Super Admin account
SUPER_ADMIN_EMAIL=your-email@gmail.com

# Required — SMTP credentials for OTP email delivery
# Use a Google App Password — NOT your real Gmail password
# Get one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-google-app-password
# Required — JWT Secret for API authentication (Must match NeuralQuery)
# Must be at least 32 characters.
JWT_SECRET=replace-with-another-long-random-string-minimum-32-characters

# Optional — CORS allowed origins (comma separated)
CORS_ORIGINS=https://knowledge-vault.onrender.com,https://neural-query.onrender.com

# Optional — Defaults shown
NODE_ENV=development
PORT=3000